# See https://docs.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
htpasswd
.htpasswd

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env / secrets — never publish
.env*
!.env.example
credentials.json
**/secrets/
wallet_data.txt
wallet_data*.txt

# vercel / amplify local artifacts
.vercel
.env.production

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime logs and agent state (per-server, can leak ops + addresses)
/logs
/logs/
*.log
*.jsonl
ec2-logs/
pm2-logs/
*.pid

# adaptive keeper snapshot (written at runtime)
logs/auto-adaptive-band-state.json

# runtime/auto-tuned overrides (calibration + chat updateConfig; per-server)
app/config/config.overrides.json
app/config/triton.overrides.json

# stop signal
.demeter-stop

# editor / OS
.idea/
.vscode/
*.swp
Thumbs.db
